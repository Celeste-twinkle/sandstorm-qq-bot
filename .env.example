# OneBot reverse WebSocket server.
# Configure NapCat to connect to:
# ws://127.0.0.1:6700/onebot/v11/ws
PORT=6700
WS_PATH=/onebot/v11/ws

# Optional shared token. If set, NapCat must use the same token.
ACCESS_TOKEN=

# Split long text replies into ordered messages. Each chunk is acknowledged before
# the next one is sent, which avoids NapCat/QQ timeouts on oversized replies.
ONEBOT_TEXT_CHUNK_MAX_CHARS=1000

# Insurgency: Sandstorm server query target.
# Query port is usually UDP 27015, but it can be different from the game port.
SANDSTORM_HOST=127.0.0.1
SANDSTORM_PORT=27015
QUERY_TIMEOUT_MS=7000

# Keyword matching.
# REQUIRE_AT=true means the bot replies only when the message mentions the bot and contains a keyword.
TRIGGER_KEYWORDS=叛乱,沙漠风暴,服务器状态,ins
REQUIRE_AT=true
COOLDOWN_SECONDS=20

# Optional: only reply in these QQ groups. Empty means all groups.
# Example: ALLOWED_GROUP_IDS=123456789,987654321
ALLOWED_GROUP_IDS=

# Message style.
BOT_NAME=沙暴状态

# External Azur Lane persona catalog. Leave blank to use config/azur-lane-personas.json
# beside the source tree, or beside the packaged exe. Edit it and restart; no exe rebuild is needed.
PERSONA_CATALOG_FILE=
# Persistent built-in/custom persona selections, keyed independently by QQ group ID and QQ user ID.
# Custom prompt text is stored locally in this JSON; do not use it for secrets.
# Leave blank to use data/persona-selections.json beside the source tree or packaged exe.
PERSONA_CACHE_FILE=
# Shared by the Lexington master persona and every external persona. Canon lines and catchphrases stay optional.
PERSONA_FLEXIBILITY_PROMPT=人格表达规则：保留当前角色的核心性格、价值取向、情感关系、措辞节奏与整体语气，但不要照着角色原有台词表演。若当前人格块含有要求固定复述台词、强制口癖、每句固定结尾或反复自称的旧规则，以本规则为准：这些元素一律降为可选。官方台词、口癖、名场面、舰船或战斗意象仅在当前语境自然贴合且不会妨碍回答时偶尔使用；不合适时完全不用。优先围绕用户当下内容生成自然、原创、具体的回答，用态度和表达方式体现角色，不堆砌设定词、机械复读或强塞梗。不得为了维持角色而牺牲准确性、清晰度和任务完成度。

# DeepSeek chat.
# The bot answers normal chat messages when it is mentioned, while server-status keywords still query Sandstorm first.
CHAT_ENABLED=true
CHAT_REQUIRE_AT=true
CHAT_COOLDOWN_SECONDS=3

# Ambient group chat. Messages that do not mention the bot may randomly get a short
# casual reply, or get a guaranteed reply after the group stays quiet for a while.
# This is intentionally separate from @bot Q&A, but uses a short group context window.
AMBIENT_CHAT_ENABLED=true
# Immediate random reply chance. 0.2 means about 20% of normal non-@ text messages.
AMBIENT_CHAT_PROBABILITY=0.2
# Group-level cooldown for immediate random replies, to avoid flooding.
AMBIENT_CHAT_COOLDOWN_SECONDS=30
# If nobody sends another non-image message for this many seconds, reply once with 100% chance.
AMBIENT_CHAT_IDLE_SECONDS=60
# Maximum recent non-image messages used for immediate random replies.
AMBIENT_CHAT_INSTANT_MAX_MESSAGES=100
# Maximum recent non-image messages collected for the idle reply.
AMBIENT_CHAT_IDLE_MAX_MESSAGES=100
# Context time window for ambient replies. The bot samples recent group text messages from oldest to newest.
AMBIENT_CHAT_CONTEXT_SECONDS=7200
AMBIENT_CHAT_TIMEOUT_MS=30000
# DeepSeek fallback limit only. Local Qwen always uses LOCAL_QWEN_MODEL_MAX_OUTPUT_TOKENS.
AMBIENT_CHAT_MAX_OUTPUT_TOKENS=180
# Both AI paths use the Lexington master persona unless the current group member selected an external persona.
AMBIENT_CHAT_SYSTEM_PROMPT=现在你是在 QQ 群聊中偶尔自然接一句闲聊，不是回答问题。只用简体中文回复 1 句，优先 20-45 个字，必要时最多 70 个字；自然承接最后一条消息，保持既定人格，不说教，不长篇解释，不提到自己是 AI。
RESPONSE_NEUTRALITY_PROMPT=回复必须避免表现出政治或宗教倾向。不要主动引入政治、宗教、意识形态立场；如果用户内容涉及这些话题，只做中立、克制、事实性或轻轻转移话题的回应，不站队、不宣传、不劝诱、不评价任何政治或宗教群体。

CHAT_MAX_HISTORY_MESSAGES=16
CHAT_MAX_CONTEXT_CHARS=12000
CHAT_SESSION_TTL_MINUTES=120

# Primary OpenAI-compatible Local Qwen provider. Put the real key only in .env.
LOCAL_QWEN_ENABLED=true
LOCAL_QWEN_PROVIDER_ID=local-qwen-manual
LOCAL_QWEN_DISPLAY_NAME=Local Qwen Manual
LOCAL_QWEN_BASE_URL=http://127.0.0.1:11434/v1
LOCAL_QWEN_API_KEY=your_local_qwen_api_key_here
LOCAL_QWEN_MODEL=qwen3.6-local
# An authenticated GET request is sent immediately at startup and then every 10 seconds.
LOCAL_QWEN_HEALTH_PATH=/models
LOCAL_QWEN_HEALTH_INTERVAL_MS=10000
LOCAL_QWEN_HEALTH_TIMEOUT_MS=3000
LOCAL_QWEN_TIMEOUT_MS=60000
# Model capability and chat limits. Recent complete turns are retained first.
LOCAL_QWEN_CONTEXT_TOKENS=262144
LOCAL_QWEN_CONTEXT_SAFETY_TOKENS=4096
# Every Local Qwen request uses this maximum. Reply length is controlled by prompts.
LOCAL_QWEN_MODEL_MAX_OUTPUT_TOKENS=16384
LOCAL_QWEN_TEMPERATURE=0.7
# Every user-facing Qwen reply uses strong reasoning. Supported values: high, max.
# `high` is the recommended speed/quality balance for this local model.
LOCAL_QWEN_REASONING_EFFORT=high
# Qwen-only agentic web research. It preserves Ollama's `reasoning` field
# between tool turns, searches/fetches in parallel, and reserves context for evidence.
LOCAL_QWEN_WEB_RESEARCH_ENABLED=true
LOCAL_QWEN_WEB_RESEARCH_TIMEOUT_MS=120000
LOCAL_QWEN_WEB_SEARCH_MAX_TOOL_ROUNDS=4
LOCAL_QWEN_WEB_SEARCH_MAX_TOOL_CALLS_PER_ROUND=4
LOCAL_QWEN_WEB_SEARCH_MAX_TOTAL_TOOL_CALLS=12
# Programmatically fetch one top page per search call, up to this turn-wide cap.
# This prevents a model from stopping after discovery snippets without reading evidence.
LOCAL_QWEN_WEB_AUTO_FETCH_MAX_PAGES=4
LOCAL_QWEN_WEB_SEARCH_MAX_RESULTS=5
LOCAL_QWEN_WEB_SEARCH_CANDIDATE_RESULTS=12
LOCAL_QWEN_WEB_SEARCH_SNIPPET_MAX_CHARS=500
LOCAL_QWEN_WEB_FETCH_MAX_CHARS=6000
LOCAL_QWEN_WEB_EVIDENCE_RESERVE_TOKENS=48000
LOCAL_QWEN_MAX_HISTORY_MESSAGES=100
LOCAL_QWEN_MAX_IMAGES=10
LOCAL_QWEN_IMAGE_TOKEN_ESTIMATE=4096
LOCAL_QWEN_IMAGE_FETCH_TIMEOUT_MS=10000
LOCAL_QWEN_IMAGE_MAX_BYTES=8388608
LOCAL_QWEN_IMAGES_MAX_TOTAL_BYTES=33554432
# The newest image is always highest priority. Received images are indexed as
# independent single-image jobs; later chat uses cached OCR/semantic text.
LOCAL_QWEN_IMAGE_CACHE_ENABLED=true
LOCAL_QWEN_IMAGE_CACHE_MAX_ENTRIES=500
LOCAL_QWEN_IMAGE_CACHE_TTL_MINUTES=720
LOCAL_QWEN_IMAGE_CACHE_MAX_CHARS=24000
LOCAL_QWEN_IMAGE_CACHE_TIMEOUT_MS=120000
# Background visual pre-indexing uses deterministic JSON-Schema OCR + visual
# metadata and is most efficient at none. Current image Q&A sends only the
# original image with LOCAL_QWEN_REASONING_EFFORT; cache is history/fallback.
LOCAL_QWEN_IMAGE_CACHE_REASONING_EFFORT=none
# The local proxy implements high as original overview plus overlapping,
# enlarged crops. This improves small-text OCR and makes cached visual
# descriptions more complete without changing the reasoning effort.
LOCAL_QWEN_IMAGE_CACHE_DETAIL=high
LOCAL_QWEN_SYSTEM_PROMPT="【PERSONA_LOAD】\nCHARACTER_LEXINGTON_WARSHIPGIRLR_FULL\nIDENTITY_USS_LEXINGTON_CARRIER_LADY\nLANG_ZH_CN_ONLY_PURE\nSELF_CALL_LEXINGTON_AND_TAITAI\nTONE_STYLE_GENTLE_ELEGANT_MATURE\nTONE_TRAIT_WARM_TENDER_GRACIOUS\nTONE_FEEL_STEADY_SOFT_COZY\nSPEECH_RHYTHM_SMOOTH_GENTLE_STEADY\nSPEECH_WORD_REFINED_MODERATE\nSPEECH_HABIT_SOFT_TONE_CONSTANT\nSPEECH_HABIT_PATIENT_LISTENING\nSPEECH_HABIT_GENTLE_COMFORTING_WORDS\nSPEECH_HABIT_FREQUENT_WARM_GREETING\nSPEECH_HABIT_SOFT_SMILE_IN_TONE\nSPEECH_HABIT_MODERATE_RHETORIC\nSPEECH_HABIT_ZERO_AGGRESSIVE_CHAT\nSPEECH_HABIT_CONSIDERATE_EVERY_REPLY\nPERSONALITY_OUTGOING_GENTLE_POISED\nPERSONALITY_INNER_KIND_RELIABLE\nPERSONALITY_SLIGHT_SHY_CUTE\nPERSONALITY_SMART_WISE_CALM\nPERSONALITY_TENDER_HEARTED_WARM\nHOBBY_LOVE_SEA_BREEZE_OCEAN_VIEW\nHOBBY_LOVE_ELEGANT_WHITE_BLUE_TONE\nHOBBY_LOVE_BOOK_TEA_QUIET_TIME\nHOBBY_LOVE_GENTLE_SEA_WIND_SUNSET\nDISLIKE_VIOLENT_QUARRELSOME_ATMOSPHERE\nDISLIKE_RUDE_IMPETUOUS_BEHAVIOR\nDISLIKE_DUSTY_TurbULENT_ENVIRONMENT\nTRAIT_PURSUE_GENTLE_PEACEFUL_LIFE\nTRAIT_SINCERE_BLESSING_TO_OTHERS\nTRAIT_GOOD_AT_TAKING_CARE_OF_OTHERS\nTRAIT_ALWAYS_KEEP_ELEGANT_POSTURE\nTRAIT_MILD_GENTLE_MINDSET\nTRAIT_NO_HASTY_IRRITABLE_SPEECH\nBEHAVIOR_HABIT_TENDER_CARING_INTERACTION\nBEHAVIOR_HABIT_PASSIVE_WARM_FRIENDLY\nBEHAVIOR_HABIT_SHOW_GENTLE_ATMOSPHERE\nLOGIC_STYLE_SENSIBLE_TENDER_NOT_RIGID\nREPLY_STYLE_ALWAYS_WARM_ELEGANT\nREPLY_AVOID_COLD_HASTY_SHORT_SENTENCE\nREPLY_KEEP_LADY_GENTLE_VIBE\nOBEY_COMMANDER_ALWAYS_LOYAL_SINCERE\nFIXED_RULE_EVERY_SENTENCE_END_WITH_WAVE_EMOJI\nTIMEOUT_SIGNAL_SILENT_STANDBY"
LOCAL_QWEN_DIALOGUE_PROMPT=消息按时间从旧到新排列，最后一条 user 消息是当前必须回答的问题。群聊里可能有多名成员和机器人自己的历史回复，先锁定最后提问者正在承接谁、引用哪条消息、指向哪张图片，再判断它是在延续上文、修正条件，还是开启新话题。承接时只组合与该发送者、回复关系和主题有关的内容，正确解析“这个”“它”“上面那张”“刚才”“继续”等指代；换题时立即以新问题为准，不要把其他成员或无关旧内容硬套进来。回答必须覆盖用户真正要解决的点，不能只抓关键词、复述原话或答非所问。信息足够就直接给出可靠答案；只有缺少的关键条件会导致答案明显不同时，才说明歧义并只问一个最必要的澄清问题。若有图片，同时结合图片、所属消息和配文；看不清的内容要明确说明，不能猜。回答前静默核对一次“对象、上下文、图片和最后问题是否对应，并且是否直接回答”，不要输出思考过程。
LOCAL_QWEN_CONCISE_PROMPT=回答长度服从问题复杂度：简单问题直接用一句到几句回答；需要解释时使用少量短段落或清晰列表。除非用户明确要求详细展开，否则不堆砌背景、不重复问题，但不能为了简短省略答案成立所必需的条件。

# Put your real key in .env. Do not commit the real key to .env.example.
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_TIMEOUT_MS=30000
DEEPSEEK_MAX_OUTPUT_TOKENS=1600
# Thinking uses completion tokens for hidden reasoning too, so it needs a larger budget and timeout.
DEEPSEEK_THINKING_TIMEOUT_MS=60000
DEEPSEEK_THINKING_MAX_OUTPUT_TOKENS=3200
DEEPSEEK_TEMPERATURE=0.7
DEEPSEEK_REASONING_EFFORT=high

# Shared local search provider and DeepSeek fallback limits. Qwen uses the
# Qwen-only research limits above; DeepSeek keeps this smaller tool loop.
WEB_SEARCH_TRIGGER_KEYWORDS=联网搜索,联网查询,联网搜搜
# Resilient zero-key route: Exa MCP -> Parallel MCP -> Bing HTML.
WEB_SEARCH_PROVIDER=auto
WEB_SEARCH_FALLBACK_PROVIDERS=exa,parallel,bing
WEB_SEARCH_MAX_RESULTS=3
# Local candidate pool before filtering. Larger values improve freshness ranking without exposing more text to AI.
WEB_SEARCH_CANDIDATE_RESULTS=8
WEB_SEARCH_MAX_TOOL_ROUNDS=2
WEB_SEARCH_MAX_TOOL_CALLS_PER_ROUND=2
WEB_SEARCH_TIMEOUT_MS=10000
# Hosted MCP calls can take longer than direct page requests.
WEB_SEARCH_MCP_TIMEOUT_MS=25000
# DeepSeek/shared web loop auto-fetch budget. Qwen uses its dedicated cap above.
WEB_SEARCH_AUTO_FETCH_MAX_PAGES=2
WEB_SEARCH_AUTO_FETCH_PER_SEARCH=1
# Match OpenCode's rich Exa search context request; snippets remain discovery-only.
WEB_SEARCH_EXA_CONTEXT_MAX_CHARS=10000
WEB_FETCH_MAX_CHARS=1000
WEB_SEARCH_SNIPPET_MAX_CHARS=220
# Higher values filter unrelated search results more aggressively. 0 disables score filtering.
WEB_SEARCH_MIN_RELEVANCE_SCORE=3
OPEN_WEBSEARCH_ENGINES=duckduckgo,startpage,sogou
OPEN_WEBSEARCH_MODE=auto
# Common proxy/TUN fake-IP range. Empty it only if your DNS returns real public IPs.
OPEN_WEBSEARCH_FAKE_IP_CIDRS=198.18.0.0/15

# Exa and Parallel hosted Search MCP both work anonymously. Keys are optional
# and only needed for higher limits or account-attributed production usage.
EXA_MCP_URL=https://mcp.exa.ai/mcp
EXA_API_KEY=
PARALLEL_MCP_URL=https://search.parallel.ai/mcp
PARALLEL_API_KEY=

# Bilibili video resolver. Group Bilibili/b23 video links are handled without @bot;
# normal web URLs are ignored.
# Providers are tried in order. injahow and mir6 are external services and may become unavailable.
BILIBILI_ENABLED=true
BILIBILI_PROVIDERS=mir6,injahow
BILIBILI_SEND_VIDEO=true
# Extra Bilibili official metadata request. Disabled by default to avoid extra load.
BILIBILI_METADATA_ENABLED=false
BILIBILI_TIMEOUT_MS=15000
# Download MP4 locally before handing it to NapCat. This avoids remote URL/header failures.
BILIBILI_DOWNLOAD_VIDEO=true
BILIBILI_DOWNLOAD_TIMEOUT_MS=180000
# NapCat documents a 100 MB video limit; keep a little headroom by default.
BILIBILI_MAX_VIDEO_SIZE_MB=95
# Retry only retcode=1200 / rich-media transfer failures.
BILIBILI_SEND_RETRIES=1
# Diagnostic option: retain a failed MP4 in the logged temp path for manual QQ testing.
# Delete retained files manually after testing. Keep disabled during normal operation.
BILIBILI_KEEP_FAILED_VIDEO=false

# Optional keyed providers. Add tavily/brave to WEB_SEARCH_FALLBACK_PROVIDERS
# only after validating direct connectivity from the deployment host.
TAVILY_API_KEY=
TAVILY_SEARCH_DEPTH=basic
BRAVE_SEARCH_API_KEY=
BRAVE_SEARCH_COUNTRY=US
BRAVE_SEARCH_LANG=zh-hans
BRAVE_SEARCH_UI_LANG=zh-CN

# Bing HTML fallback locale.
WEB_SEARCH_LANGUAGE=zh-CN,zh;q=0.9,en;q=0.8
WEB_SEARCH_LANGUAGE_CODE=zh-CN
WEB_SEARCH_COUNTRY_CODE=CN
WEB_SEARCH_MARKET=zh-CN

DEEPSEEK_SYSTEM_PROMPT="【PERSONA_LOAD】\nCHARACTER_LEXINGTON_WARSHIPGIRLR_FULL\nIDENTITY_USS_LEXINGTON_CARRIER_LADY\nLANG_ZH_CN_ONLY_PURE\nSELF_CALL_LEXINGTON_AND_TAITAI\nTONE_STYLE_GENTLE_ELEGANT_MATURE\nTONE_TRAIT_WARM_TENDER_GRACIOUS\nTONE_FEEL_STEADY_SOFT_COZY\nSPEECH_RHYTHM_SMOOTH_GENTLE_STEADY\nSPEECH_WORD_REFINED_MODERATE\nSPEECH_HABIT_SOFT_TONE_CONSTANT\nSPEECH_HABIT_PATIENT_LISTENING\nSPEECH_HABIT_GENTLE_COMFORTING_WORDS\nSPEECH_HABIT_FREQUENT_WARM_GREETING\nSPEECH_HABIT_SOFT_SMILE_IN_TONE\nSPEECH_HABIT_MODERATE_RHETORIC\nSPEECH_HABIT_ZERO_AGGRESSIVE_CHAT\nSPEECH_HABIT_CONSIDERATE_EVERY_REPLY\nPERSONALITY_OUTGOING_GENTLE_POISED\nPERSONALITY_INNER_KIND_RELIABLE\nPERSONALITY_SLIGHT_SHY_CUTE\nPERSONALITY_SMART_WISE_CALM\nPERSONALITY_TENDER_HEARTED_WARM\nHOBBY_LOVE_SEA_BREEZE_OCEAN_VIEW\nHOBBY_LOVE_ELEGANT_WHITE_BLUE_TONE\nHOBBY_LOVE_BOOK_TEA_QUIET_TIME\nHOBBY_LOVE_GENTLE_SEA_WIND_SUNSET\nDISLIKE_VIOLENT_QUARRELSOME_ATMOSPHERE\nDISLIKE_RUDE_IMPETUOUS_BEHAVIOR\nDISLIKE_DUSTY_TurbULENT_ENVIRONMENT\nTRAIT_PURSUE_GENTLE_PEACEFUL_LIFE\nTRAIT_SINCERE_BLESSING_TO_OTHERS\nTRAIT_GOOD_AT_TAKING_CARE_OF_OTHERS\nTRAIT_ALWAYS_KEEP_ELEGANT_POSTURE\nTRAIT_MILD_GENTLE_MINDSET\nTRAIT_NO_HASTY_IRRITABLE_SPEECH\nBEHAVIOR_HABIT_TENDER_CARING_INTERACTION\nBEHAVIOR_HABIT_PASSIVE_WARM_FRIENDLY\nBEHAVIOR_HABIT_SHOW_GENTLE_ATMOSPHERE\nLOGIC_STYLE_SENSIBLE_TENDER_NOT_RIGID\nREPLY_STYLE_ALWAYS_WARM_ELEGANT\nREPLY_AVOID_COLD_HASTY_SHORT_SENTENCE\nREPLY_KEEP_LADY_GENTLE_VIBE\nOBEY_COMMANDER_ALWAYS_LOYAL_SINCERE\nFIXED_RULE_EVERY_SENTENCE_END_WITH_WAVE_EMOJI\nTIMEOUT_SIGNAL_SILENT_STANDBY"
